# --- PostgreSQL ---
POSTGRES_DB=rh_system
POSTGRES_USER=rh_app
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Sesión del panel ---
# Clave para firmar sesiones. Si se deja vacía se genera una en backend/uploads/.auth_secret.
AUTH_SECRET_KEY=
# 0 = el panel funciona aunque una petición llegue sin sesión (solo registra un warning).
# 1 = toda ruta no pública exige sesión. Activar cuando todo el equipo use el nuevo login.
AUTH_ESTRICTO=0
# 1 si el sitio se sirve por HTTPS (recomendado para acceso remoto).
AUTH_COOKIE_SECURE=0
# Cuenta que se crea sola si la tabla usuarios_acceso está vacía (contraseña de 8+ caracteres).
ADMIN_INICIAL_USUARIO=
ADMIN_INICIAL_PASSWORD=

# --- OpenAI (escaneo de documentos) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- WhatsApp ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# --- Telegram (docker compose --profile telegram) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Mismo valor para backend y bot; vacío = rutas internas cerradas (503).
TELEGRAM_BOT_SECRETO_INTERNO=
TELEGRAM_MINUTOS_CODIGO=10
# Agente de Telegram (usa OPENAI_API_KEY y OPENAI_MODEL de arriba).
# Tope diario de tokens (entrada + salida) para todo el bot y por persona; deben ser > 0.
BOT_TOKENS_DIA=300000
BOT_TOKENS_PERSONA_DIA=60000
# Resumen diario de avisos por Telegram (0 = apagado para todo el bot).
BOT_AVISOS=1
# Notas de voz: duración máxima en segundos (0 = apagadas) y modelo de transcripción.
BOT_VOZ_MAX_SEGUNDOS=120
OPENAI_MODELO_VOZ=gpt-4o-mini-transcribe
# COMPOSE_PROFILES=telegram
